# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# REQUIRED. The `li_at` cookie from a logged-in LinkedIn session.
# Log into linkedin.com -> DevTools -> Application -> Cookies -> www.linkedin.com
# -> copy the `li_at` value. Use a throwaway / secondary account.
# This cookie is a full credential for that account.
LINKEDIN_LI_AT=

# OPTIONAL. The `JSESSIONID` cookie from the same session (quotes stripped
# automatically). Sent alongside `li_at`; not required.
LINKEDIN_JSESSIONID=

# REQUIRED. Bearer token(s) for the API. Every request to /api/profile must
# send `Authorization: Bearer <token>`. Comma-separated for multiple tokens.
# The server refuses to start if this is empty. Generate one with:
#   openssl rand -hex 32
# Test token used in the README examples:
AUTH_TOKENS=tross_test_9f2b7c1e4a6d8035b1c9e5f7a2d4b6c8

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Tuning -------------------------------------------------------------
REQUEST_TIMEOUT_MS=20000
# Set true to include the raw fetched HTML in the response as `raw`.
INCLUDE_RAW=false
RATE_LIMIT_PER_MIN=20
